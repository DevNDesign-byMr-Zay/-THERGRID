      "ibmApiVersion": "2026-04-15",
      "jobResults": true,
      "jobMetrics": true,
      "jobInspector": true
    }
  },
  "globalWorkspace": {
    "renderEngine": "native-webgl",
    "globe": "latitude-longitude wireframe sphere",
    "cityNodes": "real geographic coordinates",
    "cityDescent": true,
