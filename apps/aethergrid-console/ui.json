  "runtimeComposition": "semantic-dom-native-webgl",
  "runtimeUsesBackgroundReferenceImage": false,
  "spatialModel": {
    "dimensions": [
      "x",
      "y",
      "z",
      "time"
    ],
    "renderEngine": "native-webgl",
    "vertexAttribute": "vec4(x,y,z,timePhase)",
    "interaction": [
      "pointer-orbit",
      "wheel-zoom",
      "double-click-reset",
      "time-slider",
      "layer-toggle",
      "direct-node-picking"
    ],
    "backendEndpoint": "GET /api/aethergrid/spatial",
    "backgroundImageRequired": false
  },
  "designReferenceRepositoryPath": "assets/dashboard-reference.webp",
  "designReferenceIncludedInRuntimePackage": false,
  "workspaceRouting": {
    "mode": "exclusive-view",
    "workspaces": [
      "grid",
      "global",
      "holographic",
      "quantum",
      "ai",
      "scenarios",
      "evidence",
      "settings"
    ],
    "persistentSessionRoute": true
  },
  "settings": {
    "persistence": "localStorage",
    "controls": [
      "appearance-mode",
      "default-workspace",
      "density",
      "animation-intensity",
      "reduced-motion",
      "auto-rotate",
      "spatial-labels",
      "default-4d-hour",
      "live-stream",
      "fallback-refresh"
    ],
    "secretsStoredInBrowser": false,
    "appearanceModes": [
      "dark",
      "light",
      "system"
    ]
  },
  "aiRuntime": {
    "individualAgents": [
      "VÆLON",
      "AUREN",
      "SOLVÆR"
    ],
    "teamMode": true,
    "providers": [
      "local",
      "openai-compatible",
      "ollama"
    ],
    "replaceableModels": true,
    "runtimeSummaryEndpoint": "GET /api/aethergrid/runtime",
    "individualEndpoint": "POST /api/aethergrid/agents/:id",
    "teamEndpoint": "POST /api/aethergrid/team",
    "providerSecretsClientVisible": false,
    "externalContext": [
      "geospatial-summary",
      "quantum-job-summary",
      "city-operation-summary"
    ],
    "dedicatedPersistentThreads": true,
    "threadStorage": "localStorage",
    "historyWindowMessages": 16
  },
  "scenarioModel": {
    "templates": [
      "peak-demand",
      "renewable-surge",
      "storage-stress",
      "weather-event"
    ],
    "custom": true,
    "editableParameters": [
      "load-multiplier",
      "renewable-availability",
      "storage-reserve",
      "weather-risk"
    ]
  },
  "evidenceModel": {
    "listEndpoint": "GET /api/aethergrid/evidence",
    "detailEndpoint": "GET /api/aethergrid/evidence/:id",
    "records": [
      "SCENARIO",
      "OPTIMIZATION",
      "AI_AGENT",
      "AI_TEAM",
      "CITY_OPERATION"
    ],
    "contributionReceipts": true,
    "advisoryOnly": true
  },
  "holographicWorkspace": {
    "independentRenderer": true,
    "projectionModes": [
      "perspective",
      "orthographic",
      "isometric"
    ],
    "temporalModes": [
      "pulse",
      "trail",
      "freeze"
    ],
    "temporalComparison": true,
    "persistentCameraViews": true,
    "directNodePicking": true
  },
  "quantumWorkspace": {
    "objectiveSelector": true,
    "weightedObjectives": [
      "cost",
      "emissions"
    ],
    "constraints": [
      "minimum-reserve",
      "classical-baseline-required"
    ],
    "comparison": [
      "classical",
      "bounded-experimental"
    ],
    "runHistory": true,
    "receipts": true,
    "computeRuntime": {
