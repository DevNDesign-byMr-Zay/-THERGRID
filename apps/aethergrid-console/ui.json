{
  "schemaVersion": 2,
  "product": "ÆTHERGRID",
  "viewport": {
    "width": 1536,
    "height": 1024
  },
  "surfaces": [
    "OVERVIEW",
    "GRID",
    "GLOBAL",
    "HOLOGRAPHIC",
    "QUANTUM",
    "AI",
    "SCENARIOS",
    "EVIDENCE",
    "SETTINGS"
  ],
  "primaryTabs": [
    "GRID",
    "GLOBAL",
    "HOLOGRAPHIC",
    "QUANTUM",
    "AI",
    "EVIDENCE"
  ],
  "interactiveCapabilities": [
    "native-webgl-4d-grid",
    "orbit-camera",
    "wheel-zoom",
    "temporal-scrubbing",
    "wireframe-layer-toggles",
    "backend-spatial-graph",
    "live-view",
    "forecast-view",
    "scenario-view",
    "command-search",
    "region-switching",
    "metric-drilldowns",
    "holographic-wireframes",
    "run-optimization",
    "classical-comparison",
    "ai-chat",
    "agent-drilldowns",
    "evidence-review",
    "evidence-export",
    "operator-report",
    "simulation-package",
    "3d-visualization",
    "technical-evidence",
    "health-check",
    "view-reset",
    "live-event-stream",
    "workspace-router",
    "persistent-settings",
    "individual-agent-runtime",
    "team-agent-runtime",
    "replaceable-model-providers",
    "runtime-provider-status",
    "direct-node-picking",
    "custom-scenario-builder",
    "weighted-optimization-controls",
    "evidence-drill-down",
    "agent-evidence-receipts",
    "holographic-temporal-compare",
    "saved-camera-views",
    "scenario-duplication",
    "audit-timeline",
    "classical-experimental-comparison",
    "global-webgl-globe",
    "real-coordinate-world-nodes",
    "live-osm-building-geometry",
    "3d-city-wireframe-extrusion",
    "persistent-operator-profile",
    "profile-avatar",
    "quantum-backend-discovery",
    "quantum-sampler-job-submission",
    "ibm-quantum-provider",
    "local-quantum-simulator",
    "live-osm-road-topology",
    "animated-globe-city-descent"
  ],
  "agents": [
    {
      "id": "VÆLON",
      "role": "Optimization & Scenario Exploration"
    },
    {
      "id": "AUREN",
      "role": "Semantic Analysis & Spatial Intelligence"
    },
    {
      "id": "SOLVÆR",
      "role": "Simulation & Evidence Generation"
    }
  ],
  "authorityBoundary": {
    "recommendations": "ADVISORY",
    "hardwareActuation": "DISABLED",
    "infrastructureDispatch": "DISABLED",
    "evidence": "REQUIRED"
  },
  "motion": {
    "realGeometryAnimation": true,
    "effects": [
      "temporal-grid-deformation",
      "animated-transmission-routes",
      "wireframe-buildings",
      "node-pulses",
      "quantum-wave-surface",
      "scenario-line-motion",
      "wireframe-thumbnails"
    ],
    "reducedMotionSupported": true
  },
  "backendState": [
    "system",
    "metrics",
    "optimization",
    "agents",
    "evidence",
    "activity",
    "regions",
    "scenarios",
    "views"
  ],
  "runtimeComposition": "semantic-dom-native-webgl",
  "runtimeUsesBackgroundReferenceImage": false,
  "spatialModel": {
    "dimensions": [
      "x",
      "y",
      "z",
      "time"
    ],
    "renderEngine": "native-webgl",
    "vertexAttribute": "vec4(x,y,z,timePhase)",
    "interaction": [
      "pointer-orbit",
      "wheel-zoom",
      "double-click-reset",
      "time-slider",
      "layer-toggle",
      "direct-node-picking"
    ],
    "backendEndpoint": "GET /api/aethergrid/spatial",
    "backgroundImageRequired": false
  },
  "designReferenceRepositoryPath": "assets/dashboard-reference.webp",
  "designReferenceIncludedInRuntimePackage": false,
  "workspaceRouting": {
    "mode": "exclusive-view",
    "workspaces": [
      "grid",
      "global",
      "holographic",
      "quantum",
      "ai",
      "scenarios",
      "evidence",
      "settings"
    ],
    "persistentSessionRoute": true
  },
  "settings": {
    "persistence": "localStorage",
    "controls": [
      "default-workspace",
      "density",
      "animation-intensity",
      "reduced-motion",
      "auto-rotate",
      "spatial-labels",
      "default-4d-hour",
      "live-stream",
      "fallback-refresh"
    ],
    "secretsStoredInBrowser": false
  },
  "aiRuntime": {
    "individualAgents": [
      "VÆLON",
      "AUREN",
      "SOLVÆR"
    ],
    "teamMode": true,
    "providers": [
      "local",
      "openai-compatible",
      "ollama"
    ],
    "replaceableModels": true,
    "runtimeSummaryEndpoint": "GET /api/aethergrid/runtime",
    "individualEndpoint": "POST /api/aethergrid/agents/:id",
    "teamEndpoint": "POST /api/aethergrid/team",
    "providerSecretsClientVisible": false
  },
  "scenarioModel": {
    "templates": [
      "peak-demand",
      "renewable-surge",
      "storage-stress",
      "weather-event"
    ],
    "custom": true,
    "editableParameters": [
      "load-multiplier",
      "renewable-availability",
      "storage-reserve",
      "weather-risk"
    ]
  },
  "evidenceModel": {
    "listEndpoint": "GET /api/aethergrid/evidence",
    "detailEndpoint": "GET /api/aethergrid/evidence/:id",
    "records": [
      "SCENARIO",
      "OPTIMIZATION",
      "AI_AGENT",
      "AI_TEAM"
    ],
    "contributionReceipts": true,
    "advisoryOnly": true
  },
  "holographicWorkspace": {
    "independentRenderer": true,
    "projectionModes": [
      "perspective",
      "orthographic",
      "isometric"
    ],
    "temporalModes": [
      "pulse",
      "trail",
      "freeze"
    ],
    "temporalComparison": true,
    "persistentCameraViews": true,
    "directNodePicking": true
  },
  "quantumWorkspace": {
    "objectiveSelector": true,
    "weightedObjectives": [
      "cost",
      "emissions"
    ],
    "constraints": [
      "minimum-reserve",
      "classical-baseline-required"
    ],
    "comparison": [
      "classical",
      "bounded-experimental"
    ],
    "runHistory": true,
    "receipts": true,
    "computeRuntime": {
      "providers": [
        "local-simulator",
        "ibm-quantum"
      ],
      "backendDiscovery": true,
      "openQasm3Editor": true,
      "samplerSubmission": true,
      "jobList": true,
      "serverSideCredentials": true,
      "ibmApiVersion": "2026-04-15"
    }
  },
  "globalWorkspace": {
    "renderEngine": "native-webgl",
    "globe": "latitude-longitude wireframe sphere",
    "cityNodes": "real geographic coordinates",
    "cityDescent": true,
    "liveProvider": "OpenStreetMap Overpass",
    "liveBuildingGeometry": true,
    "providerFallback": "local procedural city geometry",
    "attribution": "© OpenStreetMap contributors",
    "liveRoadTopology": true,
    "animatedCityDescent": true
  },
  "profile": {
    "persistence": "backend local JSON with browser cache fallback",
    "editable": true,
    "avatar": true,
    "avatarMaxEncodedBytes": 180000
  }
}
