{
  "schemaVersion": 2,
  "id": "aethergrid.operator-console",
  "name": "ÆTHERGRID Operator Console",
  "version": "2.8.0",
  "format": "html+pwa+node-app",
  "entrypoints": {
    "standaloneHtml": "standalone.html",
    "webApp": "index.html",
    "backend": "server.mjs",
    "manifest": "manifest.webmanifest"
  },
  "visualContract": {
    "designReferenceOnly": true,
    "runtimeUsesBackgroundReferenceImage": false,
    "runtimeComposition": "semantic-dom-native-webgl-canvas",
    "referenceViewport": [
      1536,
      1024
    ],
    "target": "approved-aethergrid-command-center",
    "designReferenceRepositoryPath": "assets/dashboard-reference.webp",
    "designReferenceIncludedInRuntimePackage": false,
    "proceduralCityLightsRepresentOccupancy": false,
    "proceduralCityLightsBasis": "mapped building geometry + daylight state"
  },
  "backend": {
    "runtime": "node>=22",
    "command": "node server.mjs",
    "port": 8090,
    "apis": [
      "GET /api/aethergrid/health",
      "GET /api/aethergrid/state",
      "GET /api/aethergrid/stream",
      "GET /api/aethergrid/telemetry",
      "GET /api/aethergrid/spatial",
      "GET /api/aethergrid/evidence",
      "GET /api/aethergrid/evidence/:id",
      "GET /api/aethergrid/runtime",
      "POST /api/aethergrid/quantum/jobs",
      "GET /api/aethergrid/quantum/jobs/:id",
      "GET /api/aethergrid/quantum/jobs",
      "GET /api/aethergrid/quantum/backends",
      "GET /api/aethergrid/quantum/runtime",
      "GET /api/aethergrid/geospatial/city/:id",
      "GET /api/aethergrid/geospatial/point",
      "GET /api/aethergrid/geospatial/cities",
      "GET /api/aethergrid/geospatial/runtime",
      "GET /api/aethergrid/terrain",
      "PUT /api/aethergrid/profile",
      "GET /api/aethergrid/profile",
      "POST /api/aethergrid/view",
      "POST /api/aethergrid/region",
      "POST /api/aethergrid/scenario",
      "POST /api/aethergrid/optimize",
      "POST /api/aethergrid/agents/:id",
      "POST /api/aethergrid/team",
      "POST /api/aethergrid/chat",
      "POST /api/aethergrid/export",
      "POST /api/aethergrid/reset",
      "GET /api/aethergrid/quantum/jobs/:id/results",
      "GET /api/aethergrid/quantum/jobs/:id/metrics",
      "GET /api/aethergrid/terrain/runtime",
      "GET /api/aethergrid/city-operations/use-cases",
      "POST /api/aethergrid/city-operations/analyze",
      "GET /api/aethergrid/environment",
      "GET /api/aethergrid/environment/runtime",
      "GET /api/aethergrid/global-live",
      "GET /api/aethergrid/city-live",
      "GET /api/aethergrid/city-live/runtime"
    ]
  },
  "safety": {
    "advisoryOnly": true,
    "physicalActuation": false,
    "infrastructureDispatch": false,
    "humanReviewRequired": true
  },
  "standalone": {
    "selfContainedGeneratedAtPackageTime": true,
    "sourceHtml": "index.html",
    "outputHtml": "standalone.html",
    "externalRuntimeDependencies": false,
    "opensViaFileProtocol": true
  },
  "capabilities": {
    "semanticDomPanels": true,
    "nativeWebGL4DGrid": true,
    "interactiveWireframeMap": true,
    "backendSpatialGraph": true,
    "cameraOrbitZoom": true,
    "temporalScrubbing": true,
    "realCanvasCharts": true,
    "holographicWireframes": true,
    "liveTelemetry": true,
    "liveEventStream": true,
    "regionSwitching": true,
    "scenarioSwitching": true,
    "commandSearch": true,
    "metricDrilldowns": true,
    "aiCollaboration": true,
    "boundedOptimization": true,
    "evidenceExport": true,
    "localStandaloneFallback": true,
    "workspaceRouter": true,
    "persistentOperatorSettings": true,
    "individualAgentRuntime": true,
    "teamAgentRuntime": true,
    "replaceableModelProviders": true,
    "safeRuntimeIntrospection": true,
    "directWebGlNodePicking": true,
    "customScenarioBuilder": true,
    "weightedOptimizationControls": true,
    "evidenceDrillDown": true,
    "agentEvidenceReceipts": true,
    "holographicTemporalCompare": true,
    "savedCameraViews": true,
    "scenarioDuplication": true,
    "auditTimeline": true,
    "classicalExperimentalComparison": true,
    "persistentOperatorProfile": true,
    "avatarProfile": true,
    "globalWebGlGlobe": true,
    "realCoordinateWorldNodes": true,
    "liveOpenStreetMapCityMeshes": true,
    "cityWireframeExtrusion": true,
    "ibmQuantumComputeIntegration": true,
    "quantumBackendDiscovery": true,
    "quantumJobSubmission": true,
    "localQuantumSamplerFallback": true,
    "liveOpenStreetMapRoadTopology": true,
    "animatedGlobeCityDescent": true,
    "quantumJobResults": true,
    "quantumJobMetrics": true,
    "arbitraryCoordinateExplorer": true,
    "liveOpenStreetMapPowerGrid": true,
    "independentPowerGridLayer": true,
    "globalTemporalCityScrubbing": true,
    "liveAgentExternalContext": true,
    "liveElevationTerrain": true,
    "terrainWireframeLayer": true,
    "liveTerrainElevation": true,
    "independentTerrainLayer": true,
    "terrainFallback": true,
    "solidOpenStreetMapCityVolumes": true,
    "osmBuildingParts": true,
    "cityVisualModes": true,
    "cinematicGlobeCityTransition": true,
    "cityOperationsUseCases": true,
    "dedicatedPersistentAgentChats": true,
    "agentConversationHistory": true,
    "liveOpenWeatherCityContext": true,
    "realTimeCityTimeSync": true,
    "sourceBackedRoofGeometry": true,
    "relationBuildingGeometry": true,
    "skylineDataQualityReadout": true,
    "lightDarkSystemAppearance": true,
    "citySpecificCameraFraming": true,
    "liveGlobalSeismicFeed": true,
    "liveCityAirQuality": true,
    "weatherVectorAnimation": true,
    "precipitationAnimation": true,
    "airQualityParticleAnimation": true,
    "seismicPulseAnimation": true,
    "globalAirQualityCityPulses": true,
    "globalUtcSweep": true,
    "sourceDrivenCityUseCaseAnimation": true,
    "weatherReadinessUseCase": true,
    "airQualityExposureUseCase": true,
    "seismicAwarenessUseCase": true,
    "realTimeSolarTerminator": true,
    "liveSubsolarPoint": true,
    "nightSideCityIllumination": true,
    "windDrivenCloudDeck": true,
    "directionalPrecipitationMotion": true,
    "proceduralSkylineLighting": true,
    "solarDaylightContext": true,
    "humidityPressureContext": true,
    "heatStressUseCase": true,
    "visibilityOperationsUseCase": true
  },
  "aiRuntime": {
    "providers": [
      "local",
      "openai-compatible",
      "ollama"
    ],
    "configModule": "agent-config.mjs",
    "runtimeModule": "ai-runtime.mjs",
    "agents": [
      "VÆLON",
      "AUREN",
      "SOLVÆR",
      "TEAM"
    ],
    "secretsExposedToBrowser": false,
    "fallback": "deterministic-local",
    "replaceableByConfiguration": true,
    "externalContext": [
      "geospatial-summary",
      "quantum-job-summary",
      "city-operation-summary"
    ],
    "dedicatedPersistentThreads": true,
    "historyWindowMessages": 16
  },
  "geospatialRuntime": {
    "module": "geo-runtime.mjs",
    "providers": [
      "osm-overpass",
      "local-fallback"
    ],
    "cityRegistry": "real coordinates",
    "liveBuildingGeometry": true,
    "attributionRequired": "© OpenStreetMap contributors",
    "liveFetchOnExplicitOperatorAction": true,
    "cacheEnabled": true,
    "liveRoadTopology": true,
    "animatedCityDescent": true,
    "supportsCustomCoordinates": true,
    "livePowerLineGeometry": true,
    "livePowerAssetGeometry": true,
    "layers": [
      "buildings",
      "building-parts",
      "roads",
      "power-lines",
      "power-assets",
      "terrain",
      "roofs"
    ],
    "solidBuildingVolumes": true,
    "buildingParts": true,
    "cityVisualModes": [
      "solid",
      "xray",
      "operations"
    ],
    "cityOperations": [
      "grid-resilience",
      "outage-impact",
      "emergency-access",
      "renewable-siting",
      "load-growth",
      "weather-readiness",
      "air-quality-exposure",
      "seismic-awareness",
      "heat-stress",
      "visibility-operations"
    ],
    "skylineFocusPresets": true,
    "maxSupportedBuildingHeightM": 1200,
    "relationBuildingGeometry": true,
    "sourceBackedRoofGeometry": true,
    "upstreamTimestampVisible": true,
    "representativeBuildingLimit": 1400,
    "liveAnimatedLayers": [
      "weather",
      "air",
      "seismic",
      "clouds",
      "illumination"
    ]
  },
  "quantumRuntime": {
    "module": "quantum-runtime.mjs",
    "providers": [
      "local-simulator",
      "ibm-quantum"
    ],
    "ibmApiVersion": "2026-04-15",
    "primitives": [
      "sampler",
      "estimator"
    ],
    "credentialsExposedToBrowser": false,
    "hardwareSubmissionRequiresServerCredentials": true,
    "jobResults": true,
    "jobMetrics": true
  },
  "profileRuntime": {
    "module": "profile-store.mjs",
    "persistence": "local-json",
    "avatarResizeClientSide": true,
    "secrets": false
  },
  "terrainRuntime": {
    "module": "terrain-runtime.mjs",
    "providers": [
      "open-meteo",
      "flat-local"
    ],
    "sourceModel": "Copernicus DEM GLO-90 via Open-Meteo",
    "maxSampleGrid": 9,
    "credentialsExposedToBrowser": false,
    "explicitOperatorFetch": true
  },
  "environmentRuntime": {
    "module": "city-environment-runtime.mjs",
    "providers": [
      "open-meteo",
      "local-environment-fallback"
    ],
    "endpoint": "GET /api/aethergrid/environment",
    "runtimeEndpoint": "GET /api/aethergrid/environment/runtime",
    "currentConditions": true,
    "browserSecrets": false,
    "variables": [
      "temperature_2m",
      "apparent_temperature",
      "relative_humidity_2m",
      "surface_pressure",
      "weather_code",
      "cloud_cover",
      "is_day",
      "precipitation",
      "wind_speed_10m",
      "wind_direction_10m",
      "wind_gusts_10m",
      "shortwave_radiation",
      "visibility"
    ],
    "currentVariables": [
      "temperature_2m",
      "apparent_temperature",
      "relative_humidity_2m",
      "surface_pressure",
      "weather_code",
      "cloud_cover",
      "is_day",
      "precipitation",
      "wind_speed_10m",
      "wind_direction_10m",
      "wind_gusts_10m",
      "shortwave_radiation",
      "visibility"
    ],
    "dailyVariables": [
      "sunrise",
      "sunset",
      "daylight_duration",
      "sunshine_duration"
    ],
    "solarContext": true
  },
  "settingsRuntime": {
    "persistence": "localStorage",
    "appearanceModes": [
      "dark",
      "light",
      "system"
    ],
    "defaultAppearance": "dark"
  },
  "liveContextRuntime": {
    "module": "city-live-runtime.mjs",
    "providers": [
      "open-meteo-air-quality",
      "usgs-earthquake-feed",
      "local-fallback"
    ],
    "globalEndpoint": "GET /api/aethergrid/global-live",
    "cityEndpoint": "GET /api/aethergrid/city-live",
    "runtimeEndpoint": "GET /api/aethergrid/city-live/runtime",
    "airQualityVariables": [
      "us_aqi",
      "european_aqi",
      "pm2_5",
      "pm10",
      "ozone",
      "nitrogen_dioxide",
      "dust",
      "uv_index"
    ],
    "seismicFeed": "M2.5+ past day GeoJSON",
    "browserSecrets": false
  }
}
