# ÆTHERGRID local app configuration.
# Copy this file to ".env" in the same folder before changing provider settings.
AETHERGRID_PORT=8090

# Providers: local | openai-compatible | ollama
# local keeps the application completely offline and credential-free.
AETHERGRID_AI_PROVIDER=local
AETHERGRID_AI_MODEL=
AETHERGRID_AI_TIMEOUT_MS=45000

# OpenAI-compatible provider. Never place a real key in source control.
AETHERGRID_OPENAI_BASE_URL=https://api.openai.com/v1
AETHERGRID_OPENAI_API_KEY=

# Local Ollama.
AETHERGRID_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional per-agent overrides.
AETHERGRID_VAELON_PROVIDER=
AETHERGRID_VAELON_MODEL=
AETHERGRID_AUREN_PROVIDER=
AETHERGRID_AUREN_MODEL=
AETHERGRID_SOLVAER_PROVIDER=
AETHERGRID_SOLVAER_MODEL=
AETHERGRID_TEAM_PROVIDER=
AETHERGRID_TEAM_MODEL=

# Local persistent app data. Relative paths resolve from the app working directory.
AETHERGRID_DATA_DIR=.aethergrid-data

# Live geospatial city geometry.
# The OpenStreetMap Overpass adapter is only called when an operator explicitly descends into a city.
# Keep attribution visible and avoid automated bulk requests.
AETHERGRID_GEO_PROVIDER=osm-overpass
AETHERGRID_OVERPASS_URL=https://overpass-api.de/api/interpreter
AETHERGRID_GEO_USER_AGENT=AETHERGRID/2.6 (operator-console; configure deployment contact)
AETHERGRID_GEO_CACHE_TTL_MS=900000

# Current city environment / local-time context.
# open-meteo provides current model conditions for the active city coordinate.
# No browser credential is required or exposed by this runtime.
AETHERGRID_ENVIRONMENT_PROVIDER=open-meteo
AETHERGRID_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Elevation / terrain provider.
# open-meteo samples Copernicus DEM GLO-90 elevations for the active coordinate.
# For commercial deployments, configure the provider/API access appropriate to your Open-Meteo plan.
# flat-local keeps the terrain layer offline and flat.
AETHERGRID_TERRAIN_PROVIDER=open-meteo
AETHERGRID_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
AETHERGRID_OPEN_METEO_API_KEY=

# Quantum compute provider.
# local-simulator keeps the ZIP functional with no cloud credentials.
# To submit real jobs, set provider to ibm-quantum and configure the values below.
AETHERGRID_QUANTUM_PROVIDER=local-simulator
AETHERGRID_IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com/api/v1/
AETHERGRID_IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token
AETHERGRID_IBM_QUANTUM_API_KEY=
AETHERGRID_IBM_QUANTUM_SERVICE_CRN=
AETHERGRID_IBM_QUANTUM_BACKEND=
