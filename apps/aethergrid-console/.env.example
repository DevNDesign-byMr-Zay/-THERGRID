# ==============================================================================
# ÆTHERGRID Production Provider & Environment Configuration
# ==============================================================================

# --- Application ---
AETHERGRID_PORT=8090
AETHERGRID_DATA_DIR=.aethergrid-data

# --- Spatial ---
# Native WebGL 4D Spatial Renderer and future Cesium/3D Tiles configuration
AETHERGRID_CESIUM_ION_TOKEN=
AETHERGRID_CESIUM_BASE_URL=
AETHERGRID_GOOGLE_3D_TILES_API_KEY=
AETHERGRID_GOOGLE_3D_TILES_URL=

# --- Geospatial ---
# OpenStreetMap Overpass & Overture Maps configuration
AETHERGRID_GEO_PROVIDER=osm-overpass
AETHERGRID_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated rotation; used only when AETHERGRID_OVERPASS_URL is blank.
AETHERGRID_OVERPASS_URLS=
# Building geometry fallback and bounded Overpass building-query radius.
AETHERGRID_OSM_MAP_URL=https://api.openstreetmap.org/api/0.6/map
AETHERGRID_GEO_BUILDING_RADIUS_M=520
AETHERGRID_GEO_USER_AGENT=AETHERGRID/2.6 (operator-console; configure deployment contact)
AETHERGRID_GEO_CACHE_TTL_MS=900000
AETHERGRID_OVERTURE_MAPS_URL=
AETHERGRID_OVERTURE_API_KEY=

# --- Weather ---
# Open-Meteo & Tomorrow.io weather providers
AETHERGRID_ENVIRONMENT_PROVIDER=open-meteo
AETHERGRID_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
AETHERGRID_TOMORROW_IO_API_KEY=
AETHERGRID_TOMORROW_IO_URL=
AETHERGRID_NWS_API_URL=
# Legacy alerts-provider URL override, when the direct provider is used.
AETHERGRID_NWS_URL=

# --- Environment ---
# Environmental and local-time context settings

# --- Air Quality ---
# Open-Meteo Air Quality provider
AETHERGRID_AIR_QUALITY_PROVIDER=open-meteo
AETHERGRID_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- Seismic ---
# USGS Earthquake Feed provider
AETHERGRID_SEISMIC_PROVIDER=usgs
AETHERGRID_USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
AETHERGRID_SEISMIC_CACHE_TTL_MS=60000

# --- Terrain ---
# Open-Meteo Elevation & Copernicus DEM
AETHERGRID_TERRAIN_PROVIDER=open-meteo
AETHERGRID_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
AETHERGRID_OPEN_METEO_API_KEY=

# --- Hydrology ---
# Hydrology & water-body data provider configuration
AETHERGRID_HYDROLOGY_PROVIDER=
AETHERGRID_HYDROLOGY_API_KEY=
AETHERGRID_HYDROLOGY_BASE_URL=

# --- Energy ---
# EIA & Energy grid provider configuration
AETHERGRID_EIA_API_KEY=
AETHERGRID_EIA_BASE_URL=
# Optional legacy direct EIA provider endpoint override.
AETHERGRID_EIA_URL=

# --- Transit ---
# Transit & mobility provider configuration
# Transitland may be used as the feed discovery/catalog provider.
# Direct GTFS-Realtime vehicle feeds remain defined by AETHERGRID_GTFS_FEEDS_FILE.
AETHERGRID_TRANSIT_PROVIDER=transitland
AETHERGRID_TRANSIT_API_KEY=
AETHERGRID_TRANSIT_BASE_URL=https://transit.land/api/v2/rest
# Path to a server-side JSON registry. Do not embed secrets in this file.
AETHERGRID_GTFS_FEEDS_FILE=

# --- Quantum ---
# IBM Quantum & D-Wave quantum computing providers
AETHERGRID_QUANTUM_PROVIDER=local-simulator
AETHERGRID_IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com/api/v1/
AETHERGRID_IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token
AETHERGRID_IBM_QUANTUM_API_KEY=
AETHERGRID_IBM_QUANTUM_SERVICE_CRN=
AETHERGRID_IBM_QUANTUM_BACKEND=
AETHERGRID_DWAVE_API_TOKEN=
AETHERGRID_DWAVE_SOLVER_URL=
# Legacy D-Wave connection overrides; prefer the solver URL above.
AETHERGRID_DWAVE_BASE_URL=
AETHERGRID_DWAVE_URL=

# Optional CPU-only Qiskit Aer bridge executable; empty uses python on Windows, python3 elsewhere.
# Install the pinned requirements-qiskit.txt separately to enable this local simulator.
AETHERGRID_QISKIT_PYTHON=

# Individual external provider request timeout (milliseconds).
AETHERGRID_PROVIDER_TIMEOUT_MS=10000

# --- AI ---
# Replaceable AI agent runtime: local | openai-compatible | ollama
# Leave blank for automatic Groq selection when a private Groq key is present.
# Set local explicitly only to force the offline fallback.
AETHERGRID_AI_PROVIDER=
AETHERGRID_AI_MODEL=
AETHERGRID_AI_TIMEOUT_MS=45000
# Leave blank to preserve automatic endpoint selection.
AETHERGRID_OPENAI_BASE_URL=
AETHERGRID_OPENAI_API_KEY=
# Optional legacy / compatible AI credential aliases. Leave unused values blank.
AETHERGRID_GROQ_API_KEY=
GROQ_API_KEY=
AETHERGRID_AI_API_KEY=
AETHERGRID_AI_BASE_URL=
AETHERGRID_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Groq OpenAI-compatible cloud AI (optional):
# AETHERGRID_AI_PROVIDER=openai-compatible
# AETHERGRID_AI_MODEL=openai/gpt-oss-20b
# AETHERGRID_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AETHERGRID_OPENAI_API_KEY=<store only in .env.secrets or encrypted deployment secrets>

# Optional per-agent overrides
AETHERGRID_VAELON_PROVIDER=
AETHERGRID_VAELON_MODEL=
AETHERGRID_AUREN_PROVIDER=
AETHERGRID_AUREN_MODEL=
AETHERGRID_SOLVAER_PROVIDER=
AETHERGRID_SOLVAER_MODEL=
AETHERGRID_TEAM_PROVIDER=
AETHERGRID_TEAM_MODEL=

# --- Storage/Cache ---
# Storage and cache settings

# Local startup stays loopback-only; containers opt into 0.0.0.0.
AETHERGRID_BIND_ADDRESS=127.0.0.1

# Operator authentication. Local single-operator mode remains available when unset.
# Configure accounts with scripts/configure-aethergrid-account.mjs; never commit hashes or passwords.
AETHERGRID_AUTH_REQUIRED=0
AETHERGRID_AUTH_USERS=[]
# HTTPS deployment only; enables secure session cookies and exact origin validation.
AETHERGRID_PUBLIC_ORIGIN=

# One-time account bootstrap only: set the password in a temporary process
# environment, never save a real password in a tracked or runtime env file.
AETHERGRID_SETUP_PASSWORD=

# Optional Windows PowerShell launcher controls.
AETHERGRID_NO_BROWSER=0
AETHERGRID_LAUNCH_DIAGNOSTICS=0

# Optional server-only OpenSky OAuth; anonymous global observations refresh every 15 minutes.
AETHERGRID_OPENSKY_CLIENT_ID=
AETHERGRID_OPENSKY_CLIENT_SECRET=

# --- Opt-in credentialed live-provider smoke (NOT used by npm test) ---
# Leave these blank for local development. Set only for an explicit live smoke run.
AETHERGRID_LIVE_SMOKE_PROVIDER=
AETHERGRID_LIVE_SMOKE_LAT=
AETHERGRID_LIVE_SMOKE_LON=
AETHERGRID_LIVE_SMOKE_NWPS_GAUGE=
AETHERGRID_LIVE_SMOKE_EIA_REGION=
AETHERGRID_LIVE_SMOKE_OUTPUT=

# --- Test and build controls (optional; leave unset for ordinary startup) ---
# Node defaults to development behavior when NODE_ENV is unset. CI sets it explicitly.
NODE_ENV=
# Additional Node flags; the offline runner appends its own network guard.
NODE_OPTIONS=
# Set by CI runners. Leave empty locally (the string "false" is still truthy).
CI=
# Optional JUnit output path, relative to the repository root.
AETHERGRID_JUNIT_PATH=
# 1 tests the canonical Node-served build; 0 uses the Vite development server.
AETHERGRID_TEST_CANONICAL=0
# 1 uses the built Vite preview instead of the development server.
AETHERGRID_TEST_BUILT=0
# Optional Chromium executable and proxy URL for browser acceptance.
AETHERGRID_TEST_CHROMIUM=
AETHERGRID_TEST_PROXY=
# Explicit credentialed acceptance opt-ins; ordinary tests need no credentials.
AETHERGRID_TEST_REQUIRE_CESIUM=0
AETHERGRID_TEST_REQUIRE_CLOUD_AI=0
AETHERGRID_TEST_REQUIRE_OPERATIONAL=0
# Explicit extended replay opt-in (separate from normal acceptance).
AETHERGRID_LONG_ACCEPTANCE=0
# Optional absolute path to the direct-open HTML; defaults to local-dist/index.html.
AETHERGRID_LOCAL_HTML=
# Optional PUBLIC browser token. Vite reads this from the web workspace environment.
# Never put a private server credential in a VITE_ variable.
VITE_AETHERGRID_CESIUM_ION_TOKEN=

# Platform fallback port and CI-provided release metadata.
PORT=
GITHUB_SHA=
RELEASE_TAG=
