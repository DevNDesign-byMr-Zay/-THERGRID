{
  "name": "@aethergrid/operator-web-v4",
  "version": "4.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "playwright test",
    "test:hooks": "playwright test --config playwright.hooks.config.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:native": "playwright test --config playwright.renderer.config.ts --grep \"^native\"",
    "test:renderer": "playwright test --config playwright.renderer.config.ts"
  },
  "dependencies": {
    "@cesium/engine": "26.5.0",
    "@cesium/widgets": "16.3.1",
    "cesium": "1.147.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
