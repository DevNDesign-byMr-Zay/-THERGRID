# ÆTHERGRID local secret manifest
#
# Copy this file to .env.secrets for local development.
# .env.secrets is intentionally gitignored and MUST NOT be committed.
# In GitHub Actions / deployment, store the same names in encrypted secrets.
#
# Never put real values in this example.

# Spatial
AETHERGRID_CESIUM_ION_TOKEN=

# Weather / energy
AETHERGRID_TOMORROW_IO_API_KEY=
AETHERGRID_EIA_API_KEY=

# Live aviation (optional: anonymous city ADSB.lol works without keys;
# OpenSky global OAuth has stricter freshness/rate limits)
AETHERGRID_OPENSKY_CLIENT_ID=
AETHERGRID_OPENSKY_CLIENT_SECRET=

# Transit discovery
AETHERGRID_TRANSIT_API_KEY=

# IBM Quantum
AETHERGRID_IBM_QUANTUM_API_KEY=
AETHERGRID_IBM_QUANTUM_SERVICE_CRN=

# Open Quantum (optional, read-only SDK discovery)
# For GitHub Actions store full key JSON as an encrypted AETHERGRID_OPENQUANTUM_SDK_KEY_JSON secret.
# Locally prefer OPENQUANTUM_SDK_KEY=absolute/path/to/private/sdk-key.json.
# Do not put raw JSON secrets in a version-controlled file.
OPENQUANTUM_SDK_KEY=
OPENQUANTUM_CLIENT_ID=
OPENQUANTUM_CLIENT_SECRET=

# D-Wave (when available)
AETHERGRID_DWAVE_API_TOKEN=

# AI
# For automatic Groq setup (VÆLON, AUREN, SOLVÆR and TEAM), fill only
# AETHERGRID_GROQ_API_KEY below. The server selects the default live model.
# Groq is consumed through the existing OpenAI-compatible runtime:
# AETHERGRID_AI_PROVIDER=openai-compatible
# AETHERGRID_AI_MODEL=openai/gpt-oss-20b
# AETHERGRID_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AETHERGRID_OPENAI_API_KEY=
AETHERGRID_GROQ_API_KEY=
