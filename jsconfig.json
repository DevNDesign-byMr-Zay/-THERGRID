    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "types/checkjs-shims.d.ts",
    "src/platform-health-service.mjs",
    "src/runtime-observability.mjs",
