# ==============================================================================
# THERGRID & ÆTHERGRID Production Provider & Environment Configuration
# ==============================================================================

# --- Platform / Health ---
PORT=8080
SERVICE_NAME=thergrid
THERGRID_PORT=8080
THERGRID_LOG_LEVEL=info

# CI / Release Metadata
GITHUB_SHA=
RELEASE_TAG=

# --- Application ---
AETHERGRID_PORT=8090
AETHERGRID_DATA_DIR=.aethergrid-data

# --- Spatial ---
AETHERGRID_CESIUM_ION_TOKEN=
AETHERGRID_CESIUM_BASE_URL=
AETHERGRID_GOOGLE_3D_TILES_API_KEY=
AETHERGRID_GOOGLE_3D_TILES_URL=

# --- Geospatial ---
AETHERGRID_GEO_PROVIDER=osm-overpass
AETHERGRID_OVERPASS_URL=https://overpass-api.de/api/interpreter
AETHERGRID_OVERPASS_URLS=
AETHERGRID_OSM_MAP_URL=https://api.openstreetmap.org/api/0.6/map
AETHERGRID_GEO_BUILDING_RADIUS_M=520
AETHERGRID_GEO_USER_AGENT=AETHERGRID/2.6 (operator-console; configure deployment contact)
AETHERGRID_GEO_CACHE_TTL_MS=900000
AETHERGRID_OVERTURE_MAPS_URL=
AETHERGRID_OVERTURE_API_KEY=

# --- Weather ---
AETHERGRID_ENVIRONMENT_PROVIDER=open-meteo
AETHERGRID_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
AETHERGRID_TOMORROW_IO_API_KEY=
AETHERGRID_TOMORROW_IO_URL=
AETHERGRID_NWS_API_URL=
AETHERGRID_NWS_URL=

# --- Air Quality ---
AETHERGRID_AIR_QUALITY_PROVIDER=open-meteo
AETHERGRID_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- Seismic ---
AETHERGRID_SEISMIC_PROVIDER=usgs
AETHERGRID_USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
AETHERGRID_SEISMIC_CACHE_TTL_MS=60000

# --- Terrain ---
AETHERGRID_TERRAIN_PROVIDER=open-meteo
AETHERGRID_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
AETHERGRID_OPEN_METEO_API_KEY=

# --- Hydrology ---
AETHERGRID_HYDROLOGY_PROVIDER=
AETHERGRID_HYDROLOGY_API_KEY=
AETHERGRID_HYDROLOGY_BASE_URL=

# --- Energy ---
AETHERGRID_EIA_API_KEY=
AETHERGRID_EIA_BASE_URL=
AETHERGRID_EIA_URL=

# --- Transit ---
# Transitland may be used as the feed discovery/catalog provider.
# Direct GTFS-Realtime vehicle feeds remain defined by AETHERGRID_GTFS_FEEDS_FILE.
AETHERGRID_TRANSIT_PROVIDER=transitland
AETHERGRID_TRANSIT_API_KEY=
AETHERGRID_TRANSIT_BASE_URL=https://transit.land/api/v2/rest
# Path to a server-side JSON registry. Do not embed secrets in this file.
AETHERGRID_GTFS_FEEDS_FILE=

# --- Quantum ---
AETHERGRID_QUANTUM_PROVIDER=local-simulator
AETHERGRID_IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com/api/v1/
AETHERGRID_IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token
AETHERGRID_IBM_QUANTUM_API_KEY=
AETHERGRID_IBM_QUANTUM_SERVICE_CRN=
AETHERGRID_IBM_QUANTUM_BACKEND=
AETHERGRID_DWAVE_API_TOKEN=
AETHERGRID_DWAVE_SOLVER_URL=
AETHERGRID_DWAVE_BASE_URL=
AETHERGRID_DWAVE_URL=
AETHERGRID_PROVIDER_TIMEOUT_MS=10000

# --- AI ---
AETHERGRID_AI_PROVIDER=local
AETHERGRID_AI_MODEL=
AETHERGRID_AI_TIMEOUT_MS=45000
AETHERGRID_OPENAI_BASE_URL=https://api.openai.com/v1
AETHERGRID_OPENAI_API_KEY=
AETHERGRID_OLLAMA_BASE_URL=http://127.0.0.1:11434
AETHERGRID_QISKIT_PYTHON=

# Groq OpenAI-compatible cloud AI (optional):
# AETHERGRID_AI_PROVIDER=openai-compatible
# AETHERGRID_AI_MODEL=openai/gpt-oss-20b
# AETHERGRID_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AETHERGRID_OPENAI_API_KEY=<store only in .env.secrets or encrypted deployment secrets>

# Optional per-agent overrides
AETHERGRID_VAELON_PROVIDER=
AETHERGRID_VAELON_MODEL=
AETHERGRID_AUREN_PROVIDER=
AETHERGRID_AUREN_MODEL=
AETHERGRID_SOLVAER_PROVIDER=
AETHERGRID_SOLVAER_MODEL=
AETHERGRID_TEAM_PROVIDER=
AETHERGRID_TEAM_MODEL=

# Operator authentication. Local single-operator mode remains available when unset.
# Configure accounts with scripts/configure-aethergrid-account.mjs; never commit hashes or passwords.
AETHERGRID_AUTH_REQUIRED=0
AETHERGRID_AUTH_USERS=[]
# HTTPS deployment only; enables secure session cookies and exact origin validation.
AETHERGRID_PUBLIC_ORIGIN=
# Local startup stays loopback-only. Containers configure 0.0.0.0 explicitly.
AETHERGRID_BIND_ADDRESS=127.0.0.1
AETHERGRID_OPENSKY_CLIENT_ID=
AETHERGRID_OPENSKY_CLIENT_SECRET=
# Account setup password must only be passed by a temporary process environment.
AETHERGRID_SETUP_PASSWORD=
AETHERGRID_NO_BROWSER=0
AETHERGRID_LAUNCH_DIAGNOSTICS=0
