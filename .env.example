# Local runtime configuration. These values are non-secret examples.
PORT=8080
SERVICE_NAME=thergrid
THERGRID_PORT=8080
THERGRID_LOG_LEVEL=info

# CI/release metadata supplied automatically by GitHub Actions.
# These names are documented for complete fresh-clone environment discovery.
GITHUB_SHA=
RELEASE_TAG=

# ÆTHERGRID application server.
AETHERGRID_PORT=8090

# Replaceable AI runtime.
# Supported providers: local, openai-compatible, ollama.
# "local" requires no credentials and keeps the ZIP functional offline.
AETHERGRID_AI_PROVIDER=local
AETHERGRID_AI_MODEL=
AETHERGRID_AI_TIMEOUT_MS=45000

# OpenAI-compatible provider configuration.
# The API key is intentionally blank. Never commit a real credential.
AETHERGRID_OPENAI_BASE_URL=https://api.openai.com/v1
AETHERGRID_OPENAI_API_KEY=

# Local Ollama provider configuration.
AETHERGRID_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Per-agent overrides. Any value left blank inherits AETHERGRID_AI_*.
AETHERGRID_VAELON_PROVIDER=
AETHERGRID_VAELON_MODEL=
AETHERGRID_AUREN_PROVIDER=
AETHERGRID_AUREN_MODEL=
AETHERGRID_SOLVAER_PROVIDER=
AETHERGRID_SOLVAER_MODEL=
AETHERGRID_TEAM_PROVIDER=
AETHERGRID_TEAM_MODEL=
