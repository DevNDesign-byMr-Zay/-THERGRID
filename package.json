{
  "name": "thergrid",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/platform-health-service.mjs",
    "test": "node --test tests/*.test.mjs tests/**/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=90",
    "syntax": "find src tests scripts apps \\( -name '*.mjs' -o -name '*.js' \\) -print0 | xargs -0 -n1 node --check",
    "demo": "node scripts/demo.mjs",
    "dashboard-demo": "node scripts/dashboard-demo.mjs",
    "check": "npm run verify:release && npm run syntax && npm run lint && npm run typecheck && npm run typecheck:strict-renderer && npm run format:check && npm run coverage && npm run demo && npm run dashboard-demo",
    "lint": "eslint --max-warnings=0 src tests scripts",
    "format:check": "prettier --check 'src/**/*.mjs' 'tests/**/*.mjs' 'scripts/**/*.mjs' 'apps/operator-console/**/*.{html,css,js}'",
    "format": "prettier --write 'src/**/*.mjs' 'tests/**/*.mjs' 'scripts/**/*.mjs' 'apps/operator-console/**/*.{html,css,js}'",
    "health": "node src/platform-health-service.mjs",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:strict-renderer": "tsc -p jsconfig.strict-renderer.json",
    "operator-console": "node scripts/operator-console.mjs"
  },
  "dependencies": {
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "description": "Node.js digital-twin and energy-simulation application service with advisory spatial intelligence, evidence, and operator-review contracts.",
  "keywords": [
    "application-service",
    "backend",
    "digital-twin",
    "energy-simulation",
    "spatial-intelligence",
    "operator-review",
    "test",
    "node-test"
  ],
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "main": "src/platform-health-service.mjs",
  "exports": "./src/platform-health-service.mjs"
}
