{
  "name": "thergrid",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=90",
    "syntax": "find src tests scripts -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "demo": "node scripts/demo.mjs",
    "dashboard-demo": "node scripts/dashboard-demo.mjs",
    "check": "npm run verify:release && npm run syntax && npm run lint && npm run typecheck && npm run format:check && npm run coverage && npm run demo && npm run dashboard-demo",
    "lint": "eslint --max-warnings=0 src tests scripts",
    "format:check": "prettier --check 'src/**/*.mjs' 'tests/**/*.mjs' 'scripts/**/*.mjs'",
    "format": "prettier --write 'src/**/*.mjs' 'tests/**/*.mjs' 'scripts/**/*.mjs'",
    "health": "node src/platform-health-service.mjs",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "description": "Node.js digital-twin and energy-simulation application service with advisory spatial intelligence, evidence, and operator-review contracts.",
  "keywords": [
    "application-service",
    "backend",
    "digital-twin",
    "energy-simulation",
    "spatial-intelligence",
    "operator-review"
  ],
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
